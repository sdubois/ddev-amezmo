#!/usr/bin/env bash
#ddev-generated

set -Eeuo pipefail

readonly PROGRAM="ddev-amezmo"

load_profile() {
  local profile="$1" app_root="${DDEV_APPROOT:-$PWD}" profile_file
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || die "environment profile contains unsupported characters."
  profile_file="${app_root}/.ddev/amezmo/environments/${profile}.env"
  [[ -r "$profile_file" ]] || die "environment profile '$profile' was not found at $profile_file."

  # Profiles are add-on configuration files owned by the project.
  # shellcheck disable=SC1090
  source "$profile_file"
  [[ "${AMEZMO_ENVIRONMENT:-}" == "$profile" ]] \
    || die "profile $profile_file must set AMEZMO_ENVIRONMENT=$profile."

}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' was not found. Install it on the host and try again."
}

require_value() {
  local key="$1"
  [[ -n "${!key:-}" ]] || die "required configuration key $key is empty. Configure the selected .ddev/amezmo/environments profile or use --environment."
}

validate_token() {
  local key="$1" value="${!1:-}"
  [[ "$value" =~ ^[A-Za-z0-9._@+-]+$ ]] || die "$key contains unsupported characters. Use letters, numbers, dot, underscore, at-sign, plus, or hyphen."
}

validate_port() {
  local key="$1" value="${!1:-}"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
    die "$key must be a number from 1 through 65535."
  fi
}

validate_remote_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" == /* ]] || die "$key must be an absolute remote path."
  [[ "$value" != "/" ]] || die "$key may not be '/'."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "$key contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+,:=\ -]+$ ]] || die "$key contains unsafe shell characters."
}

validate_local_path() {
  require_value AMEZMO_LOCAL_FILES_PATH
  local value="$AMEZMO_LOCAL_FILES_PATH" part
  [[ "$value" != /* ]] || die "AMEZMO_LOCAL_FILES_PATH must be relative to the project root."
  [[ "$value" != "." ]] || die "AMEZMO_LOCAL_FILES_PATH may not be the project root."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "AMEZMO_LOCAL_FILES_PATH contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+\ -]+$ ]] || die "AMEZMO_LOCAL_FILES_PATH contains unsafe characters."
  IFS='/' read -r -a parts <<< "$value"
  for part in "${parts[@]}"; do
    [[ "$part" != ".." ]] || die "AMEZMO_LOCAL_FILES_PATH may not contain '..'."
  done
}

validate_ssh_config() {
  require_value AMEZMO_SSH_HOST
  require_value AMEZMO_SSH_PORT
  require_value AMEZMO_SSH_USER
  validate_token AMEZMO_SSH_HOST
  validate_token AMEZMO_SSH_USER
  validate_port AMEZMO_SSH_PORT
}

validate_drush_alias() {
  require_value AMEZMO_DRUSH_ALIAS
  local alias="${AMEZMO_DRUSH_ALIAS#@}"
  [[ "$alias" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "AMEZMO_DRUSH_ALIAS contains unsupported characters. Use a Drush alias name such as live or staging."
}

validate_app_type() {
  AMEZMO_APP_TYPE="${AMEZMO_APP_TYPE:-drupal}"
  case "$AMEZMO_APP_TYPE" in
    drupal|wordpress|custom) ;;
    *) die "AMEZMO_APP_TYPE must be drupal, wordpress, or custom." ;;
  esac
}

validate_command() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || die "$key contains a control character."
}

validate_cli_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" =~ ^[A-Za-z0-9_./@+-]+$ ]] \
    || die "$key contains unsupported characters."
}

ssh_target() {
  printf '%s@%s' "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST"
}

ssh_check() {
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$(ssh_target)" true >/dev/null \
    || die "SSH connection to $(ssh_target):${AMEZMO_SSH_PORT} failed. Enable SSH, trust your IP, upload your public key, and verify the host key."
}

shell_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

local_drush_path() {
  local app_root="${DDEV_APPROOT:-$PWD}"
  printf '%s/vendor/bin/drush' "$app_root"
}

validate_local_drush() {
  local drush_path
  drush_path="$(local_drush_path)"
  [[ -x "$drush_path" ]] \
    || die "local Drush executable was not found at $drush_path. Run this from a consuming project with vendor/bin/drush installed."
}

remote_command() {
  local command="$1"
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" "$command"
}

rsync_supports_protect_args() {
  rsync --help 2>&1 | grep -Fq -- '--protect-args'
}

validate_legacy_rsync_paths() {
  local key value
  for key in AMEZMO_REMOTE_FILES_PATH AMEZMO_LOCAL_FILES_PATH; do
    value="${!key}"
    [[ "$value" =~ ^[A-Za-z0-9_./@+-]+$ ]] || die \
      "installed rsync does not support --protect-args; $key must contain only letters, numbers, underscore, dot, slash, at-sign, plus, or hyphen. Upgrade rsync to use paths with spaces or other special characters."
  done
}

auth() {
  require_command ssh
  validate_ssh_config
  printf 'Checking SSH access to Amezmo environment %s at %s:%s...\n' "${AMEZMO_ENVIRONMENT:-production}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
  ssh_check
  printf 'SSH connection succeeded.\n'
}

info() {
  validate_ssh_config
  printf '%s (%s@%s:%s)\n' "$AMEZMO_ENVIRONMENT" "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
}

pull_db() {
  require_command ssh
  validate_ssh_config
  validate_app_type
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  local app_root="${DDEV_APPROOT:-$PWD}" download_dir tmp_dir dump_file
  download_dir="${app_root}/.ddev/.downloads"
  mkdir -p "$download_dir"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ddev-amezmo.XXXXXX")"
  dump_file="$tmp_dir/db.sql.gz"
  cleanup() { rm -rf "$tmp_dir"; }
  trap cleanup EXIT HUP INT TERM
  case "$AMEZMO_APP_TYPE" in
    drupal)
      validate_drush_alias
      validate_local_drush
      local drush_path drush_alias
      drush_path="$(local_drush_path)"
      drush_alias="@${AMEZMO_DRUSH_ALIAS#@}"
      printf 'Streaming database via local Drush alias @%s to %s (%s)...\n' "${AMEZMO_DRUSH_ALIAS#@}" "$AMEZMO_SSH_HOST" "${AMEZMO_ENVIRONMENT:-production}"
      if ! (cd "$app_root" && "$drush_path" "$drush_alias" sql:dump --gzip --no-interaction > "$dump_file" 2>"$tmp_dir/cli.stderr"); then
        die "Drush database dump failed; the local database has not been imported. Verify the Drush alias and remote Drupal environment."
      fi
      ;;
    wordpress)
      local remote_cli="${AMEZMO_REMOTE_CLI_PATH:-wp}"
      if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
        validate_cli_path AMEZMO_REMOTE_CLI_PATH
      fi
      printf 'Streaming database via WP-CLI from %s (%s)...\n' "$AMEZMO_SSH_HOST" "${AMEZMO_ENVIRONMENT:-production}"
      if ! remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $(shell_quote "$remote_cli") db export - --single-transaction --quiet" 2>"$tmp_dir/cli.stderr" | gzip > "$dump_file"; then
        die "WP-CLI database dump failed; the local database has not been imported. Verify AMEZMO_REMOTE_CLI_PATH and the remote WordPress installation."
      fi
      ;;
    custom)
      validate_command AMEZMO_REMOTE_DB_DUMP_COMMAND
      printf 'Streaming database via configured application command from %s (%s)...\n' "$AMEZMO_SSH_HOST" "${AMEZMO_ENVIRONMENT:-production}"
      if ! remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $AMEZMO_REMOTE_DB_DUMP_COMMAND" 2>"$tmp_dir/cli.stderr" | gzip > "$dump_file"; then
        die "Configured database dump command failed; the local database has not been imported."
      fi
      ;;
  esac
  [[ -s "$dump_file" ]] || die "remote database dump was empty; the local database has not been imported."
  gzip -t "$dump_file" || die "Database dump was not valid gzip; the local database has not been imported."
  mv "$dump_file" "$download_dir/db.sql.gz"
  printf 'Database dump downloaded; DDEV will now import it.\n'
  cleanup
  trap - EXIT HUP INT TERM
}

pull_files() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  validate_local_path
  local app_root="${DDEV_APPROOT:-$PWD}" destination
  local -a rsync_args=( -rlptz --safe-links )
  destination="$app_root/$AMEZMO_LOCAL_FILES_PATH"
  mkdir -p "$destination"
  if rsync_supports_protect_args; then
    rsync_args+=(--protect-args)
  else
    validate_legacy_rsync_paths
    printf 'Installed rsync does not support --protect-args; using legacy-safe path mode.\n' >&2
  fi
  printf 'Pulling files from %s:%s into %s (no remote writes, no deletion)...\n' "$AMEZMO_SSH_HOST" "$AMEZMO_REMOTE_FILES_PATH" "$AMEZMO_LOCAL_FILES_PATH"
  rsync_args+=(
    --no-owner --no-group \
    --exclude='/.git/' --exclude='/.env' --exclude='/.env.*' \
    --exclude='*.sql' --exclude='*.sql.gz' --exclude='/logs/' \
    --exclude='/log/' --exclude='/cache/' --exclude='/release/' \
    -e "ssh -p ${AMEZMO_SSH_PORT} -o BatchMode=yes"
  )
  rsync_args+=(
    "$(ssh_target):${AMEZMO_REMOTE_FILES_PATH%/}/" "$destination/"
  )
  rsync "${rsync_args[@]}" \
    || die "rsync failed; local files may have been partially updated. Check AMEZMO_REMOTE_FILES_PATH and remote rsync availability."
  printf 'Files pull succeeded.\n'
}

doctor() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  validate_local_path
  validate_app_type
  ssh_check
  local quoted_app quoted_files
  quoted_app="$(shell_quote "$AMEZMO_REMOTE_APP_ROOT")"
  quoted_files="$(shell_quote "$AMEZMO_REMOTE_FILES_PATH")"
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" \
    "test -d $quoted_app && test -r $quoted_app && test -d $quoted_files && test -r $quoted_files && command -v rsync >/dev/null" \
    || die "remote checks failed. Verify both remote paths are readable and rsync is installed on the Amezmo instance."
  case "$AMEZMO_APP_TYPE" in
    drupal)
      validate_drush_alias
      validate_local_drush
      local drush_alias drush_path
      drush_alias="@${AMEZMO_DRUSH_ALIAS#@}"
      drush_path="$(local_drush_path)"
      if ! (cd "${DDEV_APPROOT:-$PWD}" && "$drush_path" "$drush_alias" status --no-interaction >/dev/null 2>/dev/null); then
        die "Drush database connectivity failed. Verify AMEZMO_DRUSH_ALIAS and the configured remote site alias."
      fi
      ;;
    wordpress)
      local remote_cli="${AMEZMO_REMOTE_CLI_PATH:-wp}"
      if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
        validate_cli_path AMEZMO_REMOTE_CLI_PATH
      fi
      remote_command "cd $quoted_app && $(shell_quote "$remote_cli") db check --quiet" >/dev/null 2>&1 \
        || die "WP-CLI database connectivity failed. Verify AMEZMO_REMOTE_CLI_PATH and the remote WordPress installation."
      ;;
    custom)
      validate_command AMEZMO_REMOTE_HEALTH_COMMAND
      remote_command "cd $quoted_app && $AMEZMO_REMOTE_HEALTH_COMMAND" >/dev/null 2>&1 \
        || die "Configured application health command failed."
      ;;
  esac
  printf 'Amezmo doctor passed for %s at %s:%s. Local files target: %s\n' "${AMEZMO_ENVIRONMENT:-production}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT" "$AMEZMO_LOCAL_FILES_PATH"
}

if [[ "${1:-}" == "--profile" ]]; then
  [[ $# -ge 3 ]] || die "--profile requires an environment name and action."
  load_profile "$2"
  shift 2
fi

case "${1:-}" in
  info) info ;;
  auth) auth ;;
  pull-db) pull_db ;;
  pull-files) pull_files ;;
  doctor) doctor ;;
  *) die "unknown action '${1:-}'. Expected info, auth, pull-db, pull-files, or doctor." ;;
esac
