#!/usr/bin/env bash
#ddev-generated
# shellcheck disable=SC2016

set -Eeuo pipefail

readonly PROGRAM="ddev-amezmo"

load_profile() {
  local profile="$1" app_root="${DDEV_APPROOT:-$PWD}" profile_file
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || die "environment name contains unsupported characters."
  profile_file="${app_root}/.ddev/amezmo/environments/${profile}.env"
  [[ -r "$profile_file" ]] || die "Amezmo environment profile '$profile' was not found at $profile_file."

  # Profiles are add-on configuration files owned by the project.
  # shellcheck disable=SC1090
  source "$profile_file"
  [[ "${AMEZMO_ENVIRONMENT:-}" == "$profile" ]] \
    || die "$profile_file must set AMEZMO_ENVIRONMENT=$profile."

}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' was not found. Install it on the host and try again."
}

require_value() {
  local key="$1"
  [[ -n "${!key:-}" ]] || die "Amezmo setting $key is empty. Configure it in the selected environment profile."
}

validate_token() {
  local key="$1" value="${!1:-}"
  [[ "$value" =~ ^[A-Za-z0-9._@+-]+$ ]] || die "$key contains unsupported characters. Use letters, numbers, dot, underscore, at-sign, plus, or hyphen."
}

validate_port() {
  local key="$1" value="${!1:-}"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
    die "$key must be a number from 1 through 65535."
  fi
}

validate_remote_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" == /* ]] || die "$key must be an absolute path on the Amezmo environment."
  [[ "$value" != "/" ]] || die "$key may not be '/'; choose the specific application or storage directory."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "$key contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+,:=\ -]+$ ]] || die "$key contains characters that cannot be used safely in an Amezmo path."
}

validate_local_path() {
  require_value AMEZMO_LOCAL_FILES_PATH
  local value="$AMEZMO_LOCAL_FILES_PATH" part
  [[ "$value" != /* ]] || die "AMEZMO_LOCAL_FILES_PATH must be relative to the local project root."
  [[ "$value" != "." ]] || die "AMEZMO_LOCAL_FILES_PATH may not be the local project root."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "AMEZMO_LOCAL_FILES_PATH contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+\ -]+$ ]] || die "AMEZMO_LOCAL_FILES_PATH contains characters that cannot be used safely."
  IFS='/' read -r -a parts <<< "$value"
  for part in "${parts[@]}"; do
    [[ "$part" != ".." ]] || die "AMEZMO_LOCAL_FILES_PATH may not contain '..' paths."
  done
}

validate_transfer_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" == /* ]] || die "$key must be an absolute temporary transfer path."
  [[ "$value" != "/" ]] || die "$key may not be '/'."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "$key contains a control character."
}

validate_ssh_config() {
  require_value AMEZMO_SSH_HOST
  require_value AMEZMO_SSH_PORT
  AMEZMO_SSH_USER="${AMEZMO_SSH_USER:-deployer}"
  validate_token AMEZMO_SSH_HOST
  validate_token AMEZMO_SSH_USER
  validate_port AMEZMO_SSH_PORT
}

validate_site_uri() {
  if [[ -z "${AMEZMO_SITE_URI:-}" ]]; then
    validate_instance_id
    require_value AMEZMO_ENVIRONMENT
    validate_token AMEZMO_ENVIRONMENT
    require_command php

    local cli_path environment_json app_domain
    cli_path="$(amezmo_cli_path)"
    [[ -r "$cli_path" ]] \
      || die "The Amezmo default site URI requires the bundled amezmo-cli at $cli_path."
    environment_json="$(php "$cli_path" environments get "$AMEZMO_INSTANCE_ID" "$AMEZMO_ENVIRONMENT" --output=json --no-interaction)" \
      || die "Could not read the default site URI from Amezmo. Set AMEZMO_SITE_URI explicitly or authenticate amezmo-cli."
    app_domain="$(printf '%s' "$environment_json" | php -r '
      $data = json_decode(stream_get_contents(STDIN), true);
      $value = is_array($data) ? ($data["app_domain"] ?? "") : "";
      if (is_scalar($value)) { echo $value; }
    ')" || die "Could not parse the default site URI returned by Amezmo."
    [[ -n "$app_domain" ]] \
      || die "Amezmo did not return a default site URI. Set AMEZMO_SITE_URI explicitly for the selected environment."
    AMEZMO_SITE_URI="https://${app_domain}"
  fi
  [[ "$AMEZMO_SITE_URI" != *$'\n'* && "$AMEZMO_SITE_URI" != *$'\r'* ]] \
    || die "AMEZMO_SITE_URI contains a control character."
  [[ "$AMEZMO_SITE_URI" =~ ^https?://[^[:space:]]+$ ]] \
    || die "AMEZMO_SITE_URI must be a complete HTTP or HTTPS URL for the selected environment."
}

validate_app_type() {
  AMEZMO_APP_TYPE="${AMEZMO_APP_TYPE:-drupal}"
  case "$AMEZMO_APP_TYPE" in
    drupal|wordpress|custom) ;;
    *) die "AMEZMO_APP_TYPE must be drupal, wordpress, or custom." ;;
  esac
}

validate_command() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || die "$key contains a control character."
}

validate_cli_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" =~ ^[A-Za-z0-9_./@+-]+$ ]] \
    || die "$key contains characters that cannot be used safely in a command path."
}

validate_instance_id() {
  require_value AMEZMO_INSTANCE_ID
  [[ "$AMEZMO_INSTANCE_ID" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "AMEZMO_INSTANCE_ID contains unsupported characters."
}

auto_trust_ssh_ip_enabled() {
  case "${AMEZMO_AUTO_TRUST_SSH_IP:-false}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    0|false|FALSE|no|NO|off|OFF|'') return 1 ;;
    *) die "AMEZMO_AUTO_TRUST_SSH_IP must be true or false." ;;
  esac
}

amezmo_cli_path() {
  local app_root="${DDEV_APPROOT:-$PWD}"
  printf '%s/.ddev/amezmo/bin/amezmo-cli.phar' "$app_root"
}

current_public_ip() {
  require_command curl
  local ip
  ip="$(curl --fail --silent --show-error --location --max-time 10 https://api.ipify.org)" \
    || die "Could not determine the current public IP address. Check network access or disable automatic SSH IP updates."
  ip="${ip//$'\n'/}"
  [[ "$ip" =~ ^[0-9A-Fa-f:.]+$ && "$ip" =~ [0-9] ]] \
    || die "The public IP address returned by the IP service was invalid."
  printf '%s' "$ip"
}

update_trusted_ssh_ip() {
  auto_trust_ssh_ip_enabled || return 0
  validate_instance_id
  require_command php
  local cli_path ip environment_json ip_in_list=0
  cli_path="$(amezmo_cli_path)"
  [[ -r "$cli_path" ]] || die "Automatic SSH IP update requires the bundled amezmo-cli at $cli_path."
  ip="$(current_public_ip)"
  printf "SSH access was rejected. Checking whether Amezmo trusts this public IP (%s)...\n" "$ip" >&2
  environment_json="$(php "$cli_path" environments get "$AMEZMO_INSTANCE_ID" "$AMEZMO_ENVIRONMENT" --output=json --no-interaction)" \
    || die "Could not read Amezmo environment access settings with amezmo-cli. Check AMEZMO_API_KEY and AMEZMO_INSTANCE_ID."

  while IFS= read -r existing_ip; do
    [[ -n "$existing_ip" ]] || continue
    if [[ "$existing_ip" == "$ip" ]]; then
      ip_in_list=1
    fi
  done < <(printf '%s' "$environment_json" | php -r '
    $data = json_decode(stream_get_contents(STDIN), true);
    foreach (($data["trusted_ssh_ips"] ?? []) as $ip) {
        if (is_string($ip)) { echo $ip, PHP_EOL; }
    }
  ')

  if (( ip_in_list )); then
    printf 'Amezmo already trusts the current public IP. Retrying SSH access...\n' >&2
    return 0
  fi

  local answer
  printf 'Add %s to the trusted SSH IPs for Amezmo %s? [y/N] ' "$ip" "$AMEZMO_ENVIRONMENT" >&2
  if ! IFS= read -r answer || [[ ! "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    die "Automatic SSH IP update was not approved; SSH access was not retried."
  fi

  local -a update_args=(environments update "$AMEZMO_INSTANCE_ID" "$AMEZMO_ENVIRONMENT" --trusted-ssh-ip "$ip" --yes --no-interaction)
  while IFS= read -r existing_ip; do
    [[ -n "$existing_ip" ]] || continue
    update_args+=(--trusted-ssh-ip "$existing_ip")
  done < <(printf '%s' "$environment_json" | php -r '
    $data = json_decode(stream_get_contents(STDIN), true);
    foreach (($data["trusted_ssh_ips"] ?? []) as $ip) {
        if (is_string($ip)) { echo $ip, PHP_EOL; }
    }
  ')
  printf 'Adding the current public IP to Amezmo trusted SSH IPs with amezmo-cli...\n' >&2
  php "$cli_path" "${update_args[@]}" >/dev/null \
    || die "Could not add the current public IP to Amezmo trusted SSH IPs with amezmo-cli."
}

ssh_target() {
  printf '%s@%s' "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST"
}

ssh_check() {
  if ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$(ssh_target)" true >/dev/null; then
    return 0
  fi
  update_trusted_ssh_ip
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$(ssh_target)" true >/dev/null \
    || die "Could not connect to Amezmo's SSH endpoint $(ssh_target):${AMEZMO_SSH_PORT}. Enable SSH, add your public key, trust your current IP if required, and verify the host key."
}

shell_quote() {
  local value="$1" prefix
  printf "'"
  while [[ "$value" == *"'"* ]]; do
    prefix="${value%%\'*}"
    printf '%s%s' "$prefix" "'\\''"
    value="${value#*\'}"
  done
  printf "%s'" "$value"
}

remote_command() {
  local command="$1"
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" "$command"
}

remote_command_tty() {
  local command="$1"
  if [[ -t 0 && -t 1 ]]; then
    ssh -t -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" "$command"
  else
    remote_command "$command"
  fi
}

build_remote_drush_command() {
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  validate_site_uri
  local remote_cli="${AMEZMO_REMOTE_CLI_PATH:-vendor/bin/drush}" argument
  if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
    validate_cli_path AMEZMO_REMOTE_CLI_PATH
  fi
  REMOTE_DRUSH_INVOCATION="$(shell_quote "$remote_cli") $(shell_quote "--uri=$AMEZMO_SITE_URI")"
  for argument in "$@"; do
    REMOTE_DRUSH_INVOCATION+=" $(shell_quote "$argument")"
  done
  REMOTE_DRUSH_COMMAND="cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $REMOTE_DRUSH_INVOCATION"
}

build_remote_drush_import_command() {
  build_remote_drush_command sql:connect
  REMOTE_DRUSH_COMMAND="cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && \$($REMOTE_DRUSH_INVOCATION)"
}

remote_drush_tty() {
  build_remote_drush_command "$@"
  remote_command_tty "$REMOTE_DRUSH_COMMAND"
}

rsync_supports_protect_args() {
  rsync --help 2>&1 | grep -Fq -- '--protect-args'
}

validate_legacy_rsync_paths() {
  local key value
  local -a keys=(AMEZMO_REMOTE_FILES_PATH)
  if [[ -z "${DDEV_AMEZMO_TRANSFER_FILES_PATH:-}" ]]; then
    keys+=(AMEZMO_LOCAL_FILES_PATH)
  fi
  for key in "${keys[@]}"; do
    value="${!key}"
    [[ "$value" =~ ^[A-Za-z0-9_./@+-]+$ ]] || die \
      "installed rsync does not support --protect-args; $key must contain only letters, numbers, underscore, dot, slash, at-sign, plus, or hyphen. Upgrade rsync to use paths with spaces or other special characters."
  done
}

auth() {
  require_command ssh
  validate_ssh_config
  printf "Checking SSH access to Amezmo's %s environment at %s:%s...\n" "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
  ssh_check
  printf 'SSH connection succeeded.\n'
}

info() {
  validate_ssh_config
  printf 'Amezmo %s environment — SSH endpoint %s@%s:%s\n' "$AMEZMO_ENVIRONMENT" "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
}

run_drush() {
  [[ $# -gt 0 ]] || die "drush requires a command or option."
  require_command ssh
  validate_ssh_config
  ssh_check
  validate_app_type
  [[ "$AMEZMO_APP_TYPE" == "drupal" ]] \
    || die "drush is available only when AMEZMO_APP_TYPE=drupal."
  remote_drush_tty "$@"
}

pull_db() {
  require_command ssh
  validate_ssh_config
  ssh_check
  validate_app_type
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  local app_root="${DDEV_APPROOT:-$PWD}" download_dir tmp_dir dump_file destination_file
  download_dir="${app_root}/.ddev/.downloads"
  mkdir -p "$download_dir"
  destination_file="${DDEV_AMEZMO_TRANSFER_DB_FILE:-$download_dir/db.sql.gz}"
  if [[ -n "${DDEV_AMEZMO_TRANSFER_DB_FILE:-}" ]]; then
    validate_transfer_path DDEV_AMEZMO_TRANSFER_DB_FILE
    mkdir -p "$(dirname "$destination_file")"
  fi
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ddev-amezmo.XXXXXX")"
  dump_file="$tmp_dir/db.sql.gz"
  cleanup() { rm -rf "$tmp_dir"; }
  trap cleanup EXIT HUP INT TERM
  case "$AMEZMO_APP_TYPE" in
    drupal)
      build_remote_drush_command sql:dump --gzip --no-interaction
      printf 'Downloading the Amezmo database from %s using site-local Drush...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      if ! remote_command "$REMOTE_DRUSH_COMMAND" > "$dump_file" 2>"$tmp_dir/cli.stderr"; then
        die "Could not download the Amezmo database with Drush. Verify AMEZMO_REMOTE_APP_ROOT, AMEZMO_REMOTE_CLI_PATH, the site URI, and the selected environment."
      fi
      ;;
    wordpress)
      local remote_cli="${AMEZMO_REMOTE_CLI_PATH:-wp}"
      if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
        validate_cli_path AMEZMO_REMOTE_CLI_PATH
      fi
      printf 'Downloading the Amezmo database from %s using WP-CLI...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      if ! remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $(shell_quote "$remote_cli") db export - --single-transaction --quiet" 2>"$tmp_dir/cli.stderr" | gzip > "$dump_file"; then
        die "Could not download the Amezmo database with WP-CLI. Verify AMEZMO_REMOTE_CLI_PATH and the selected Amezmo WordPress environment."
      fi
      ;;
    custom)
      validate_command AMEZMO_REMOTE_DB_DUMP_COMMAND
      printf 'Downloading the Amezmo database from %s using the configured application command...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      if ! remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $AMEZMO_REMOTE_DB_DUMP_COMMAND" 2>"$tmp_dir/cli.stderr" | gzip > "$dump_file"; then
        die "Could not download the Amezmo database with the configured application command."
      fi
      ;;
  esac
  [[ -s "$dump_file" ]] || die "The Amezmo database export was empty; the local database was not changed."
  gzip -t "$dump_file" || die "The Amezmo database export was not valid gzip; the local database was not changed."
  mv "$dump_file" "$destination_file"
  if [[ -z "${DDEV_AMEZMO_TRANSFER_PURPOSE:-}" ]]; then
    printf 'Amezmo database downloaded. DDEV will now import it into the local database.\n'
  else
    printf 'Amezmo database export downloaded and validated.\n'
  fi
  cleanup
  trap - EXIT HUP INT TERM
}

pull_files() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  ssh_check
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  if [[ -n "${DDEV_AMEZMO_TRANSFER_FILES_PATH:-}" ]]; then
    validate_transfer_path DDEV_AMEZMO_TRANSFER_FILES_PATH
  else
    validate_local_path
  fi
  local app_root="${DDEV_APPROOT:-$PWD}" destination
  local -a rsync_args=( -rlptz --safe-links )
  destination="${DDEV_AMEZMO_TRANSFER_FILES_PATH:-$app_root/$AMEZMO_LOCAL_FILES_PATH}"
  mkdir -p "$destination"
  if rsync_supports_protect_args; then
    rsync_args+=(--protect-args)
  else
    validate_legacy_rsync_paths
    printf 'Installed rsync does not support --protect-args; using compatibility-safe path mode.\n' >&2
  fi
  printf "Downloading persistent storage from Amezmo's %s environment at %s into local path %s (Amezmo is not changed; files are not deleted)...\n" "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_REMOTE_FILES_PATH" "$destination"
  rsync_args+=(
    --no-owner --no-group \
    --exclude='/.git/' --exclude='/.env' --exclude='/.env.*' \
    --exclude='*.sql' --exclude='*.sql.gz' --exclude='/logs/' \
    --exclude='/log/' --exclude='/cache/' --exclude='/release/' \
    -e "ssh -p ${AMEZMO_SSH_PORT} -o BatchMode=yes"
  )
  rsync_args+=(
    "$(ssh_target):${AMEZMO_REMOTE_FILES_PATH%/}/" "$destination/"
  )
  rsync "${rsync_args[@]}" \
    || die "Persistent storage download failed; local files may be partially updated. Check the Amezmo storage path and rsync availability."
  printf 'Persistent storage download completed.\n'
}

push_warning() {
  if [[ -n "${DDEV_AMEZMO_COPY_SOURCE:-}" ]]; then
    printf "\nWARNING: This will copy %s from Amezmo's %s environment into its %s environment at %s:%s.\n" \
      "${DDEV_AMEZMO_COPY_ASSET:-data}" "$DDEV_AMEZMO_COPY_SOURCE" "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT" >&2
  else
    printf "\nWARNING: This will upload your local database and persistent storage files to Amezmo's %s environment at %s:%s.\n" \
      "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT" >&2
  fi
  case "${DDEV_AMEZMO_COPY_ASSET:-}" in
    database) printf 'The database copy will replace the target database contents.\n' >&2 ;;
    files) printf 'The file copy overwrites matching files but does not delete files already in the target environment.\n' >&2 ;;
    *) printf 'The database upload can replace the target database contents. File uploads overwrite matching files but do not delete files already in the environment.\n' >&2 ;;
  esac
  printf 'Continue only if this Amezmo environment and the local data are correct.\n\n' >&2
}

push_db() {
  require_command ssh
  validate_ssh_config
  ssh_check
  validate_app_type
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  local app_root="${DDEV_APPROOT:-$PWD}" dump_file remote_cli
  dump_file="${DDEV_AMEZMO_TRANSFER_DB_FILE:-$app_root/.ddev/.downloads/db.sql.gz}"
  if [[ -n "${DDEV_AMEZMO_TRANSFER_DB_FILE:-}" ]]; then
    validate_transfer_path DDEV_AMEZMO_TRANSFER_DB_FILE
  fi
  [[ -s "$dump_file" ]] || die "local database dump was not found at $dump_file. DDEV should create it before db_push_command runs."
  gzip -t "$dump_file" || die "local database dump is not valid gzip: $dump_file"
  push_warning

  case "$AMEZMO_APP_TYPE" in
    drupal)
      build_remote_drush_import_command
      if [[ -n "${DDEV_AMEZMO_COPY_SOURCE:-}" ]]; then
        printf 'Importing the copied database into Amezmo %s with Drush...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      else
        printf 'Uploading the local database to Amezmo %s with Drush...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      fi
      gzip -dc "$dump_file" | remote_command "$REMOTE_DRUSH_COMMAND" \
        || die "Could not upload the database to Amezmo with Drush. Verify AMEZMO_REMOTE_APP_ROOT, AMEZMO_REMOTE_CLI_PATH, the site URI, and the selected environment."
      ;;
    wordpress)
      remote_cli="${AMEZMO_REMOTE_CLI_PATH:-wp}"
      if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
        validate_cli_path AMEZMO_REMOTE_CLI_PATH
      fi
      printf 'Uploading the local database to Amezmo %s with WP-CLI...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      gzip -dc "$dump_file" | remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $(shell_quote "$remote_cli") db import -" \
        || die "Could not upload the database to Amezmo with WP-CLI. Verify AMEZMO_REMOTE_CLI_PATH and the selected environment."
      ;;
    custom)
      validate_command AMEZMO_REMOTE_DB_IMPORT_COMMAND
      printf 'Uploading the local database to Amezmo %s with the configured application command...\n' "${AMEZMO_ENVIRONMENT:-unknown}"
      gzip -dc "$dump_file" | remote_command "cd $(shell_quote "$AMEZMO_REMOTE_APP_ROOT") && $AMEZMO_REMOTE_DB_IMPORT_COMMAND" \
        || die "Could not upload the database with the configured application command."
      ;;
  esac
  printf 'Database upload completed.\n'
}

push_files() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  ssh_check
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  if [[ -n "${DDEV_AMEZMO_TRANSFER_FILES_PATH:-}" ]]; then
    validate_transfer_path DDEV_AMEZMO_TRANSFER_FILES_PATH
  else
    validate_local_path
  fi
  local app_root="${DDEV_APPROOT:-$PWD}" source
  local -a rsync_args=( -rlptz --safe-links )
  source="${DDEV_AMEZMO_TRANSFER_FILES_PATH:-$app_root/$AMEZMO_LOCAL_FILES_PATH}"
  [[ -d "$source" ]] || die "Local persistent storage directory was not found at $source"
  push_warning
  if rsync_supports_protect_args; then
    rsync_args+=(--protect-args)
  else
    validate_legacy_rsync_paths
    printf 'Installed rsync does not support --protect-args; using compatibility-safe path mode.\n' >&2
  fi
  printf "Uploading persistent storage from local path %s to Amezmo's %s environment at %s (existing Amezmo files are not deleted)...\n" "$source" "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_REMOTE_FILES_PATH"
  rsync_args+=(
    --no-owner --no-group \
    --exclude='/.git/' --exclude='/.env' --exclude='/.env.*' \
    --exclude='*.sql' --exclude='*.sql.gz' --exclude='/logs/' \
    --exclude='/log/' --exclude='/cache/' --exclude='/release/' \
    -e "ssh -p ${AMEZMO_SSH_PORT} -o BatchMode=yes"
  )
  rsync_args+=(
    "$source/" "$(ssh_target):${AMEZMO_REMOTE_FILES_PATH%/}/"
  )
  rsync "${rsync_args[@]}" \
    || die "Persistent storage upload failed; Amezmo files may be partially updated. Check the Amezmo storage path and rsync availability."
  printf 'Persistent storage upload completed.\n'
}

doctor() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  validate_local_path
  validate_app_type
  ssh_check
  local quoted_app quoted_files
  quoted_app="$(shell_quote "$AMEZMO_REMOTE_APP_ROOT")"
  quoted_files="$(shell_quote "$AMEZMO_REMOTE_FILES_PATH")"
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" \
    "test -d $quoted_app && test -r $quoted_app && test -d $quoted_files && test -r $quoted_files && command -v rsync >/dev/null" \
    || die "Amezmo environment checks failed. Verify the application root and persistent storage paths are readable and rsync is installed."
  case "$AMEZMO_APP_TYPE" in
    drupal)
      build_remote_drush_command status --no-interaction
      if ! remote_command "$REMOTE_DRUSH_COMMAND" >/dev/null 2>/dev/null; then
        die "Drush database connectivity failed. Verify AMEZMO_REMOTE_APP_ROOT, AMEZMO_REMOTE_CLI_PATH, the site URI, and the selected environment."
      fi
      ;;
    wordpress)
      local remote_cli="${AMEZMO_REMOTE_CLI_PATH:-wp}"
      if [[ -n "${AMEZMO_REMOTE_CLI_PATH:-}" ]]; then
        validate_cli_path AMEZMO_REMOTE_CLI_PATH
      fi
      remote_command "cd $quoted_app && $(shell_quote "$remote_cli") db check --quiet" >/dev/null 2>&1 \
        || die "Could not connect to the Amezmo WordPress database with WP-CLI. Verify AMEZMO_REMOTE_CLI_PATH and the selected environment."
      ;;
    custom)
      validate_command AMEZMO_REMOTE_HEALTH_COMMAND
      remote_command "cd $quoted_app && $AMEZMO_REMOTE_HEALTH_COMMAND" >/dev/null 2>&1 \
        || die "The configured Amezmo application health check failed."
      ;;
  esac
  printf 'Amezmo %s environment check passed. SSH endpoint: %s:%s. Local persistent storage path: %s\n' "${AMEZMO_ENVIRONMENT:-unknown}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT" "$AMEZMO_LOCAL_FILES_PATH"
}

if [[ "${1:-}" == "--profile" ]]; then
  [[ $# -ge 3 ]] || die "--profile requires an environment name and action."
  load_profile "$2"
  shift 2
fi

case "${1:-}" in
  info) info ;;
  adapter) validate_app_type; printf '%s\n' "$AMEZMO_APP_TYPE" ;;
  auth) auth ;;
  drush) shift; run_drush "$@" ;;
  pull-db) pull_db ;;
  pull-files) pull_files ;;
  doctor) doctor ;;
  push-db) push_db ;;
  push-files) push_files ;;
  *) die "unknown action '${1:-}'. Expected info, adapter, auth, drush, pull-db, pull-files, push-db, push-files, or doctor." ;;
esac
