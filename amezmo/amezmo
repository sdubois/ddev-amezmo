#!/usr/bin/env bash
#ddev-generated

set -Eeuo pipefail

readonly PROGRAM="ddev-amezmo"

load_profile() {
  local profile="$1" app_root="${DDEV_APPROOT:-$PWD}" profile_file
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || die "environment profile contains unsupported characters."
  profile_file="${app_root}/.ddev/amezmo/environments/${profile}.env"
  [[ -r "$profile_file" ]] || die "environment profile '$profile' was not found at $profile_file."

  # Profiles are add-on configuration files owned by the project.
  # shellcheck disable=SC1090
  source "$profile_file"
  [[ "${AMEZMO_ENVIRONMENT:-}" == "$profile" ]] \
    || die "profile $profile_file must set AMEZMO_ENVIRONMENT=$profile."

  local password_key="${AMEZMO_DB_PASSWORD_VARIABLE:-}"
  [[ "$password_key" =~ ^[A-Z][A-Z0-9_]*$ ]] \
    || die "profile $profile_file must set AMEZMO_DB_PASSWORD_VARIABLE to a valid environment variable name."
}

resolve_db_password() {
  local password_key="${AMEZMO_DB_PASSWORD_VARIABLE:-AMEZMO_DB_PASSWORD}" discovered_password
  if [[ -z "${AMEZMO_DB_PASSWORD:-}" ]]; then
    AMEZMO_DB_PASSWORD="${!password_key:-}"
  fi
  if [[ -z "$AMEZMO_DB_PASSWORD" ]] && command -v ddev >/dev/null 2>&1; then
    discovered_password="$(ddev exec -s web printenv "$password_key" 2>/dev/null || true)"
    AMEZMO_DB_PASSWORD="$discovered_password"
  fi
  export AMEZMO_DB_PASSWORD
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' was not found. Install it on the host and try again."
}

require_value() {
  local key="$1"
  [[ -n "${!key:-}" ]] || die "required configuration key $key is empty. Configure the selected .ddev/amezmo/environments profile or use --environment."
}

validate_token() {
  local key="$1" value="${!1:-}"
  [[ "$value" =~ ^[A-Za-z0-9._@+-]+$ ]] || die "$key contains unsupported characters. Use letters, numbers, dot, underscore, at-sign, plus, or hyphen."
}

validate_port() {
  local key="$1" value="${!1:-}"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
    die "$key must be a number from 1 through 65535."
  fi
}

validate_remote_path() {
  local key="$1" value="${!1:-}"
  require_value "$key"
  [[ "$value" == /* ]] || die "$key must be an absolute remote path."
  [[ "$value" != "/" ]] || die "$key may not be '/'."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "$key contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+,:=\ -]+$ ]] || die "$key contains unsafe shell characters."
}

validate_local_path() {
  require_value AMEZMO_LOCAL_FILES_PATH
  local value="$AMEZMO_LOCAL_FILES_PATH" part
  [[ "$value" != /* ]] || die "AMEZMO_LOCAL_FILES_PATH must be relative to the project root."
  [[ "$value" != "." ]] || die "AMEZMO_LOCAL_FILES_PATH may not be the project root."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "AMEZMO_LOCAL_FILES_PATH contains a control character."
  [[ "$value" =~ ^[A-Za-z0-9_./@+\ -]+$ ]] || die "AMEZMO_LOCAL_FILES_PATH contains unsafe characters."
  IFS='/' read -r -a parts <<< "$value"
  for part in "${parts[@]}"; do
    [[ "$part" != ".." ]] || die "AMEZMO_LOCAL_FILES_PATH may not contain '..'."
  done
}

validate_ssh_config() {
  require_value AMEZMO_SSH_HOST
  require_value AMEZMO_SSH_PORT
  require_value AMEZMO_SSH_USER
  validate_token AMEZMO_SSH_HOST
  validate_token AMEZMO_SSH_USER
  validate_port AMEZMO_SSH_PORT
}

validate_db_config() {
  local key
  resolve_db_password
  for key in AMEZMO_DB_HOST AMEZMO_DB_PORT AMEZMO_DB_NAME AMEZMO_DB_USER AMEZMO_DB_PASSWORD; do
    require_value "$key"
  done
  validate_token AMEZMO_DB_HOST
  validate_port AMEZMO_DB_PORT
  validate_token AMEZMO_DB_NAME
  validate_token AMEZMO_DB_USER
  [[ "$AMEZMO_DB_PASSWORD" != *$'\n'* && "$AMEZMO_DB_PASSWORD" != *$'\r'* ]] || die "AMEZMO_DB_PASSWORD may not contain a newline."
}

ssh_target() {
  printf '%s@%s' "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST"
}

ssh_check() {
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$(ssh_target)" true >/dev/null \
    || die "SSH connection to $(ssh_target):${AMEZMO_SSH_PORT} failed. Enable SSH, trust your IP, upload your public key, and verify the host key."
}

shell_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

mysql_option_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

make_remote_db_script() {
  local destination="$1" mode="$2" escaped_password
  escaped_password="$(mysql_option_escape "$AMEZMO_DB_PASSWORD")"
  {
    # These deliberately single-quoted strings generate a script for the remote shell.
    # shellcheck disable=SC2016
    printf '%s\n' 'set -eu' 'umask 077' 'credential_file=$(mktemp "${TMPDIR:-/tmp}/ddev-amezmo.XXXXXX")' 'cleanup() { rm -f "$credential_file"; }' 'trap cleanup EXIT HUP INT TERM'
    # shellcheck disable=SC2016
    printf 'cat >"$credential_file" <<\047DDEV_AMEZMO_CREDENTIALS\047\n[client]\npassword="%s"\nDDEV_AMEZMO_CREDENTIALS\n' "$escaped_password"
    if [[ "$mode" == "dump" ]]; then
      # shellcheck disable=SC2016
      printf 'mysqldump --defaults-extra-file="$credential_file" --host=%s --port=%s --user=%s --single-transaction --quick --skip-lock-tables --default-character-set=utf8mb4 -- %s\n' \
        "$(shell_quote "$AMEZMO_DB_HOST")" "$(shell_quote "$AMEZMO_DB_PORT")" "$(shell_quote "$AMEZMO_DB_USER")" "$(shell_quote "$AMEZMO_DB_NAME")"
    else
      # shellcheck disable=SC2016
      printf 'mysql --defaults-extra-file="$credential_file" --host=%s --port=%s --user=%s --database=%s --batch --skip-column-names --execute=%s >/dev/null\n' \
        "$(shell_quote "$AMEZMO_DB_HOST")" "$(shell_quote "$AMEZMO_DB_PORT")" "$(shell_quote "$AMEZMO_DB_USER")" "$(shell_quote "$AMEZMO_DB_NAME")" "$(shell_quote 'SELECT 1')"
    fi
  } > "$destination"
  chmod 600 "$destination"
}

auth() {
  require_command ssh
  validate_ssh_config
  printf 'Checking SSH access to Amezmo environment %s at %s:%s...\n' "${AMEZMO_ENVIRONMENT:-production}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
  ssh_check
  printf 'SSH connection succeeded.\n'
}

info() {
  validate_ssh_config
  printf '%s (%s@%s:%s)\n' "$AMEZMO_ENVIRONMENT" "$AMEZMO_SSH_USER" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT"
}

pull_db() {
  require_command ssh
  require_command gzip
  validate_ssh_config
  validate_db_config
  local app_root="${DDEV_APPROOT:-$PWD}" download_dir tmp_dir remote_script dump_file
  download_dir="${app_root}/.ddev/.downloads"
  mkdir -p "$download_dir"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ddev-amezmo.XXXXXX")"
  remote_script="$tmp_dir/remote-db.sh"
  dump_file="$tmp_dir/db.sql.gz"
  cleanup() { rm -rf "$tmp_dir"; }
  trap cleanup EXIT HUP INT TERM
  make_remote_db_script "$remote_script" dump
  printf 'Streaming database %s from %s (%s)...\n' "$AMEZMO_DB_NAME" "$AMEZMO_SSH_HOST" "${AMEZMO_ENVIRONMENT:-production}"
  if ! ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" sh -s < "$remote_script" | gzip > "$dump_file"; then
    die "remote database dump failed; the local database has not been imported. Verify mysqldump and the AMEZMO_DB_* settings."
  fi
  [[ -s "$dump_file" ]] || die "remote database dump was empty; the local database has not been imported."
  mv "$dump_file" "$download_dir/db.sql.gz"
  printf 'Database dump downloaded; DDEV will now import it.\n'
  cleanup
  trap - EXIT HUP INT TERM
}

pull_files() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  validate_local_path
  local app_root="${DDEV_APPROOT:-$PWD}" destination
  destination="$app_root/$AMEZMO_LOCAL_FILES_PATH"
  mkdir -p "$destination"
  printf 'Pulling files from %s:%s into %s (no remote writes, no deletion)...\n' "$AMEZMO_SSH_HOST" "$AMEZMO_REMOTE_FILES_PATH" "$AMEZMO_LOCAL_FILES_PATH"
  rsync -rlptz --safe-links --protect-args \
    --no-owner --no-group \
    --exclude='/.git/' --exclude='/.env' --exclude='/.env.*' \
    --exclude='*.sql' --exclude='*.sql.gz' --exclude='/logs/' \
    --exclude='/log/' --exclude='/cache/' --exclude='/release/' \
    -e "ssh -p ${AMEZMO_SSH_PORT} -o BatchMode=yes" \
    "$(ssh_target):${AMEZMO_REMOTE_FILES_PATH%/}/" "$destination/" \
    || die "rsync failed; local files may have been partially updated. Check AMEZMO_REMOTE_FILES_PATH and remote rsync availability."
  printf 'Files pull succeeded.\n'
}

doctor() {
  require_command ssh
  require_command rsync
  validate_ssh_config
  validate_remote_path AMEZMO_REMOTE_APP_ROOT
  validate_remote_path AMEZMO_REMOTE_FILES_PATH
  validate_local_path
  validate_db_config
  ssh_check
  local quoted_app quoted_files tmp_dir remote_script
  quoted_app="$(shell_quote "$AMEZMO_REMOTE_APP_ROOT")"
  quoted_files="$(shell_quote "$AMEZMO_REMOTE_FILES_PATH")"
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" \
    "test -d $quoted_app && test -r $quoted_app && test -d $quoted_files && test -r $quoted_files && command -v mysqldump >/dev/null && command -v mysql >/dev/null && command -v rsync >/dev/null" \
    || die "remote checks failed. Verify both remote paths are readable and mysql, mysqldump, and rsync are installed on the Amezmo instance."
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ddev-amezmo-doctor.XXXXXX")"
  remote_script="$tmp_dir/remote-db.sh"
  cleanup() { rm -rf "$tmp_dir"; }
  trap cleanup EXIT HUP INT TERM
  make_remote_db_script "$remote_script" check
  ssh -p "$AMEZMO_SSH_PORT" -o BatchMode=yes "$(ssh_target)" sh -s < "$remote_script" >/dev/null \
    || die "database connectivity failed. Verify AMEZMO_DB_HOST, AMEZMO_DB_PORT, AMEZMO_DB_NAME, AMEZMO_DB_USER, and the local secret AMEZMO_DB_PASSWORD."
  printf 'Amezmo doctor passed for %s at %s:%s. Local files target: %s\n' "${AMEZMO_ENVIRONMENT:-production}" "$AMEZMO_SSH_HOST" "$AMEZMO_SSH_PORT" "$AMEZMO_LOCAL_FILES_PATH"
  cleanup
  trap - EXIT HUP INT TERM
}

if [[ "${1:-}" == "--profile" ]]; then
  [[ $# -ge 3 ]] || die "--profile requires an environment name and action."
  load_profile "$2"
  shift 2
fi

case "${1:-}" in
  info) info ;;
  auth) auth ;;
  pull-db) pull_db ;;
  pull-files) pull_files ;;
  doctor) doctor ;;
  *) die "unknown action '${1:-}'. Expected info, auth, pull-db, pull-files, or doctor." ;;
esac
