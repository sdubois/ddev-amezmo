#ddev-generated
# Do not derive this environment's paths from production. Copy the exact
# SSH endpoint, application root, and persistent storage paths from Amezmo.
export AMEZMO_ENVIRONMENT=staging
export AMEZMO_INSTANCE_ID=""
export AMEZMO_AUTO_TRUST_SSH_IP=true
export AMEZMO_APP_TYPE=drupal
export AMEZMO_SSH_HOST=""
export AMEZMO_SSH_PORT=""
export AMEZMO_SSH_USER=deployer
export AMEZMO_REMOTE_APP_ROOT=""
export AMEZMO_SITE_URI=""
export AMEZMO_REMOTE_FILES_PATH=""
export AMEZMO_LOCAL_FILES_PATH=""
# Optional application CLI path. Drupal defaults to vendor/bin/drush; WordPress defaults to wp.
# export AMEZMO_REMOTE_CLI_PATH=vendor/bin/drush
# Required for custom database uploads; receives SQL on standard input.
# export AMEZMO_REMOTE_DB_IMPORT_COMMAND="mysql --defaults-extra-file=/path/to/credentials.cnf database_name"
