#!/usr/bin/env bash
#ddev-generated
## Description: Download from, upload to, or check a named Amezmo environment
## Usage: amezmo <pull|push|doctor> <environment> [flags]
##        amezmo cli <command> [arguments]
## Example: "ddev amezmo pull production"
##          "ddev amezmo cli whoami"

set -Eeuo pipefail

print_push_warning() {
  local profile_file="${DDEV_APPROOT}/.ddev/amezmo/environments/${environment}.env"
  if [[ -r "$profile_file" ]]; then
    # shellcheck disable=SC1090
    source "$profile_file"
  fi
  printf "\nWARNING: This will upload your local database and persistent storage files to Amezmo's %s environment.\n" \
    "${AMEZMO_ENVIRONMENT:-$environment}" >&2
  printf 'Amezmo SSH endpoint: %s:%s.\n' \
    "${AMEZMO_SSH_HOST:-<not configured>}" "${AMEZMO_SSH_PORT:-<not configured>}" >&2
  printf 'The database upload can replace the target database contents. File uploads overwrite matching files but do not delete files already in the environment.\n' >&2
  printf 'DDEV may use generic "upstream production" wording in its next confirmation; the selected Amezmo target is %s.\n\n' "${AMEZMO_ENVIRONMENT:-$environment}" >&2
}

action="${1:-}"

if [[ "$action" == "cli" ]]; then
  shift
  cli_path="${DDEV_APPROOT}/.ddev/amezmo/bin/amezmo-cli.phar"
  if [[ ! -r "$cli_path" ]]; then
    echo "ddev-amezmo: bundled amezmo-cli was not found at $cli_path." >&2
    exit 1
  fi
  if ! command -v php >/dev/null 2>&1; then
    echo "ddev-amezmo: PHP 8.3 or newer is required to run the bundled amezmo-cli, but PHP was not found on the host." >&2
    exit 1
  fi
  if ! php -r 'exit(version_compare(PHP_VERSION, "8.3.0", ">=") ? 0 : 1);'; then
    echo "ddev-amezmo: PHP 8.3 or newer is required to run the bundled amezmo-cli (found $(php -r 'echo PHP_VERSION;'))." >&2
    exit 1
  fi
  exec php "$cli_path" "$@"
fi

environment="${2:-}"

if ! [[ "$environment" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Usage: ddev amezmo <pull|push|doctor> <environment> [flags]" >&2
  exit 2
fi

case "$action" in
  doctor)
    if [[ $# -ne 2 ]]; then
      echo "Usage: ddev amezmo doctor <environment>" >&2
      exit 2
    fi
    exec "${DDEV_APPROOT}/.ddev/amezmo/amezmo" --profile "$environment" doctor
    ;;
  pull)
    provider="${DDEV_APPROOT}/.ddev/providers/amezmo-${environment}.yaml"
    if [[ ! -r "$provider" ]]; then
      echo "ddev-amezmo: provider configuration for Amezmo environment '$environment' was not found at $provider." >&2
      exit 1
    fi
    shift 2
    exec ddev pull "amezmo-${environment}" "$@"
    ;;
  push)
    provider="${DDEV_APPROOT}/.ddev/providers/amezmo-${environment}.yaml"
    if [[ ! -r "$provider" ]]; then
      echo "ddev-amezmo: provider configuration for Amezmo environment '$environment' was not found at $provider." >&2
      exit 1
    fi
    print_push_warning
    shift 2
    exec ddev push "amezmo-${environment}" "$@"
    ;;
  *)
    echo "Usage: ddev amezmo <pull|push|doctor> <environment> [flags]" >&2
    echo "       ddev amezmo cli <command> [arguments]" >&2
    exit 2
    ;;
esac
