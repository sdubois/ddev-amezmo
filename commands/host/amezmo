#!/usr/bin/env bash
#ddev-generated
## Description: Pull or validate a named Amezmo environment
## Usage: amezmo <pull|doctor> <environment> [flags]
## Example: "ddev amezmo pull production"

set -Eeuo pipefail

action="${1:-}"
environment="${2:-}"

if ! [[ "$environment" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Usage: ddev amezmo <pull|doctor> <environment> [flags]" >&2
  exit 2
fi

case "$action" in
  doctor)
    if [[ $# -ne 2 ]]; then
      echo "Usage: ddev amezmo doctor <environment>" >&2
      exit 2
    fi
    exec "${DDEV_APPROOT}/.ddev/amezmo/amezmo" --profile "$environment" doctor
    ;;
  pull)
    provider="${DDEV_APPROOT}/.ddev/providers/amezmo-${environment}.yaml"
    if [[ ! -r "$provider" ]]; then
      echo "ddev-amezmo: provider for environment '$environment' was not found at $provider." >&2
      exit 1
    fi
    shift 2
    exec ddev pull "amezmo-${environment}" "$@"
    ;;
  *)
    echo "Usage: ddev amezmo <pull|doctor> <environment> [flags]" >&2
    exit 2
    ;;
esac
